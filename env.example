# Local dev: bật DEBUG. Production: bỏ dòng DEBUG hoặc set False.
DEBUG=True

# Production BẮT BUỘC set. Tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Salt riêng cho hash feedback (khuyến nghị set để rotate SECRET_KEY an toàn)
FEEDBACK_HASH_SALT=

ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# Production PythonAnywhere ví dụ:
# ALLOWED_HOSTS=yourname.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com

# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_SSL_REQUIRE=True
TIME_ZONE=Asia/Ho_Chi_Minh

# ── Thông báo Discord (tùy chọn) ──
# Tạo webhook: Discord channel -> Server Settings -> Integrations -> Webhooks -> Copy URL.
# Webhook CHỈ có quyền đăng tin vào đúng channel đó, không đọc được gì, không liên quan account ai.
DISCORD_WEBHOOK_URL=
# Các thứ gửi nhắc (0=Thứ 2 ... 6=CN). Mặc định thứ 2 và thứ 5.
DISCORD_NOTIFY_DAYS=0,3
# URL web để chèn link vào tin nhắc, ví dụ https://yourname.pythonanywhere.com
SITE_URL=

# ── Lịch bang chiến tự tạo (mặc định: thứ 7, 20:00, khóa sổ trước 2 tiếng) ──
# WAR_WEEKDAY=5
# WAR_TIME=20:00
# WAR_DEADLINE_OFFSET_MIN=120
# @everyone trong tin nhắc: true (mặc định) ping cả bang, false để tắt.
DISCORD_MENTION_EVERYONE=true

# Token cho endpoint /internal/daily-ops/ (GitHub Actions gọi hàng ngày).
# BẮT BUỘC để hệ tự tạo event tuần hoạt động. Tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
# Điền CÙNG giá trị này vào GitHub repo Secret tên OPS_TOKEN.
OPS_TOKEN=
